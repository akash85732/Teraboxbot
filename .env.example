# Telegram API credentials (required) -> https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# Bot token (required) -> https://t.me/BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram owner / admin user ids (multiple allowed - comma separated, e.g. 123,456,789)
OWNER_ID=0

# Max file size in bytes (default 2GB)
MAX_FILE_SIZE=2147483648

# Max concurrent VPS downloads (default 3)
MAX_CONCURRENT_DOWNLOADS=3

# Auto-delete seconds for sent files (default 600 = 10 min)
AUTO_DELETE_SECONDS=600

# Optional Web App Player URL (e.g. https://your-username.github.io/Teraboxbot/player.html or Render URL)
WEB_APP_URL=

# Optional health check port used by Railway / Render
PORT=8080