# Telegram Bot Config
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# TeraBox Cookie (ndus value from browser)
COOKIE_NDUS=your_ndus_cookie_here

# Force Subscribe Channel ID or Username (e.g., -1001234567890 or @MyChannel)
FSUB_CHANNEL=your_channel_username_or_id

# Auto Delete Time in Seconds (Default: 600 seconds = 10 minutes)
AUTO_DELETE_SECONDS=600

# MongoDB URI (Optional: for cloud user storage, else uses local users.json)
MONGO_URI=

# Bot Admin / Settings
DUMP_CHANNEL_ID=0
OWNER_ID=your_telegram_user_id
MAX_FILE_SIZE=2147483648
WORKERS=8

# Render Health Check Port
PORT=8080
